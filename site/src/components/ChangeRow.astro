---
// One change in a list (the Latest feed and "More recent changes").
// Leads with what changed: the AI summary when there is one (strongest text in the
// row), otherwise one line of the company's own changed wording in the serif with a
// visible − / + marker, so it reads as a quote rather than a link.
const { change: c, base, ageClass } = Astro.props;
const SEV = { major: "major", moderate: "mod" };
const rated = c.severity && c.severity !== "pending";
const plural = (n, word) => `${n.toLocaleString("en-US")} ${word}${n === 1 ? "" : "s"}`;
const day = new Date(c.date + "T00:00:00Z").toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const size = `${plural(c.changedWords, "word")} changed in ${plural(c.hunks.length, "place")}`;
---
<a class={`row ${ageClass(c.date)}${c.severity === "major" ? " is-major" : ""}`} href={`${base}/change/${c.id}/`} data-tags={[c.severity, ...c.categories, `co:${c.company}`].join(" ")}>
  <span class="when">{day}</span>
  <span class="who"><b>{c.companyName}</b><span>{c.docName}</span>{rated && <span class={`sev ${SEV[c.severity] ?? ""}`}>{c.severity.charAt(0).toUpperCase() + c.severity.slice(1)}</span>}</span>
  <span class="what">
    {c.summary ? (
      <span class="sum-line">{c.summary}</span>
    ) : c.excerpt && !c.likelyLayout ? (
      <span class={`ex ${c.excerpt.kind}`}><span class="mk" aria-hidden="true">{c.excerpt.kind === "add" ? "+" : "−"}</span>{c.excerpt.kind === "add"
        ? <ins><span class="sr-only">Added: </span>{c.excerpt.text}</ins>
        : <del><span class="sr-only">Removed: </span>{c.excerpt.text}</del>}</span>
    ) : null}
    <span class="note">{c.likelyLayout
      ? `Mostly a page-layout or archive change (${c.percent}% of the page), probably not new rules.`
      : c.summary ? size : `${size}. No summary yet.`}</span>
  </span>
</a>
