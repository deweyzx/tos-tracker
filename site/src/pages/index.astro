---
import Base from "../layouts/Base.astro";
import ChangeRow from "../components/ChangeRow.astro";
import { loadData, CATEGORY_LABELS, whenFound } from "../lib/data.js";

const data = loadData();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { featured: f, changes, companies, policies, categoryCounts, historyPending, noArchive, charts } = data;

const fmt = (d) => new Date(d + "T00:00:00Z").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
const fmtLong = (d) => new Date(d + "T00:00:00Z").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const fmtMonth = (d) => new Date(d + "T00:00:00Z").toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
const SEV = { major: "major", moderate: "mod" };
const sevLabel = (s) => s.charAt(0).toUpperCase() + s.slice(1);
const rated = (c) => c.severity && c.severity !== "pending";
const plural = (n, word) => `${n.toLocaleString("en-US")} ${word}${n === 1 ? "" : "s"}`;

// Afterglow: a change gives off light while it's fresh and fades over a year.
// age-0 = found in the last month, age-1 = last 3 months, age-2 = last year, age-3 = older (dark).
const built = new Date(data.builtAt);
const daysOld = (d) => (built - new Date(d + "T00:00:00Z")) / 864e5;
const ageClass = (d) => {
  const days = daysOld(d);
  return days <= 31 ? "age-0" : days <= 92 ? "age-1" : days <= 365 ? "age-2" : "age-3";
};

const readable = policies.filter((p) => p.readable).length;
const majors = changes.filter((c) => c.severity === "major").length;
const summarized = changes.filter(rated).length;
// Topic filters only help once enough changes have summaries; until then they'd hide almost everything.
const cats = summarized >= 10 ? Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]) : [];
// Pages the tracker can't read itself, named one by one ("Reddit's Privacy Policy"), since a company's other page may be fine.
const unreadable = policies.filter((p) => !p.readable).map((p) => `${companies.find((c) => c.id === p.company)?.name}'s ${p.name}`);
const listNames = (names) => names.length < 2 ? names.join("") : `${names.slice(0, -1).join(", ")} and ${names.at(-1)}`;

// "Found this month": the newest changes, so the Overview answers "what changed recently?"
// The overview lists the newest changes that matter (Moderate and Major); Minor edits
// (a heading, a link label, spacing) stay in Latest and only fill in if there aren't five.
const others = changes.filter((c) => c.id !== f?.id);
const newest = [...others.filter((c) => c.severity === "major" || c.severity === "moderate"), ...others.filter((c) => c.severity !== "major" && c.severity !== "moderate")].slice(0, 5)
  .sort((a, b) => b.date.localeCompare(a.date));


// The Latest feed, grouped under month headings (newest first). Months after the
// first ~30 changes fold behind a button (the script folds them; without it, all show).
const months = [];
for (const c of changes) {
  const key = c.date.slice(0, 7);
  if (months.at(-1)?.key !== key) months.push({ key, label: fmtMonth(c.date), items: [] });
  months.at(-1).items.push(c);
}
let shown = 0;
for (const m of months) { m.older = shown >= 30; shown += m.items.length; }
const olderCount = months.filter((m) => m.older).reduce((n, m) => n + m.items.length, 0);
---
<Base home>
  <main class="grid" id="main" data-view="overview">
    <header class="intro" data-v="overview">
      <h1>What big tech changed in its privacy policies and terms</h1>
      <p>ToS Tracker reads the privacy policies and terms of service of {companies.length} companies every morning. When the wording changes, it shows exactly what was removed and added, with a plain-English summary.</p>
    </header>
    <header class="viewhead" data-v="latest"><h1>Latest changes</h1><p>Every change found so far, newest first. Older changes come from copies saved by the Internet Archive.</p></header>
    <header class="viewhead" data-v="companies"><h1>Companies</h1><p>The {companies.length} companies being watched. Pin the ones you care about to keep them one click away.</p></header>
    <header class="viewhead" data-v="history">
      <div><h1>History</h1><p>How long each policy has been over time, and when it changed, built from copies saved by the Internet Archive.</p></div>
      {charts.length > 1 && (
        <div class="pop">
          <button class="popbtn" id="hBtn" aria-haspopup="listbox" aria-expanded="false" aria-controls="hMenu"><span id="hLabel">{charts[0].title}</span><svg viewBox="0 0 9 12" aria-hidden="true"><path d="M1.5 4 4.5 1 7.5 4M1.5 8l3 3 3-3"/></svg></button>
          <ul class="menu" id="hMenu" role="listbox" aria-label="Choose a policy" tabindex="-1">
            <li class="cap" role="presentation">Most recently changed first</li>
            {charts.map((ch, i) => (
              <li class="mi" role="option" data-key={ch.key} aria-selected={i === 0 ? "true" : "false"}><svg class="ck" viewBox="0 0 12 12"><path d="M2 6.5 5 9.5 10 2.5"/></svg>{ch.title}<span class="n">{ch.changes.length}</span></li>
            ))}
          </ul>
        </div>
      )}
    </header>

    {f ? (
      <article class={`correction ${ageClass(f.date)}`} data-v="overview" aria-labelledby="f-title">
        <svg class="pencil" aria-hidden="true"><rect x="0" y="0" width="100%" height="100%" pathLength="1" /></svg>
        <h2 id="f-title" class="vt-head">{f.summary ? f.headline : `${f.companyName} rewrote part of its ${f.docName}`}</h2>
        {f.quote ? (
          <p class="quote"><del><span class="sr-only">Removed: </span>{f.quote.before}</del> <ins><span class="sr-only">Added: </span>{f.quote.after}</ins></p>
        ) : f.excerpt ? (
          <p class="quote">{f.excerpt.kind === "add" ? <ins><span class="sr-only">Added: </span>{f.excerpt.text}</ins> : <del><span class="sr-only">Removed: </span>{f.excerpt.text}</del>}</p>
        ) : (
          <p class="noquote">{f.summary}</p>
        )}
        <p class="size">{rated(f) && <span class={`sev ${SEV[f.severity] ?? ""}`}>{sevLabel(f.severity)}</span>}{f.companyName} {f.docName}, {whenFound(f)}. {plural(f.changedWords, "word")} changed in {plural(f.hunks.length, "place")}{f.percent !== null && `, about ${f.percent}% of the policy`}.{!f.summary && " The plain-English summary hasn't been written yet."}</p>
        <div class="acts">
          <a class="cta" href={`${base}/change/${f.id}/`}>Read the whole change</a>
          {f.archiveBefore && <a class="ghost" href={f.archiveBefore} target="_blank" rel="noopener">See the old version</a>}
        </div>
      </article>
    ) : (
      <article class="correction" data-v="overview">
        <h2>No changes found yet</h2>
        <p class="noquote">The tracker reads every page each morning. The first change will show up here.</p>
      </article>
    )}

    <aside class="week" data-v="overview" aria-labelledby="how-title">
      <h2 id="how-title">How it works</h2>
      <p class="lead">Every morning at <b id="runtime">6:23 AM Eastern</b> it saves a fresh copy of each page and compares it with the last one. Only real wording changes count, not formatting or dates.</p>
      <dl class="facts">
        <div><dt>Watching</dt><dd>{policies.length} pages from {companies.length} companies</dd></div>
        <div><dt>Changes found since 2023</dt><dd>{changes.length}</dd></div>
        <div><dt>Summarized so far</dt><dd>{summarized}{majors > 0 && ` (${majors} rated major)`}</dd></div>
        <div><dt>Pages it can read today</dt><dd>{readable} of {policies.length}</dd></div>
      </dl>
      {unreadable.length > 0 && <p class="meter-note">{listNames(unreadable)} {unreadable.length === 1 ? "blocks" : "block"} automated readers, so {unreadable.length === 1 ? "it isn't" : "they aren't"} checked daily. {unreadable.length === 1 ? "Its" : "Their"} history still comes from the Internet Archive.</p>}
    </aside>

    {newest.length > 0 && (
      <section class="list recent panel" data-v="overview" aria-labelledby="recent-title">
        <div class="h"><h2 id="recent-title">More recent changes</h2><a class="more-link" href={`${base}/#latest`}>See all {changes.length} changes</a></div>
        {newest.map((c) => <ChangeRow change={c} base={base} ageClass={ageClass} />)}
      </section>
    )}

    <section class="list panel" data-v="latest" id="feed">
      <div class="h">
        <h2 id="lcount" tabindex="-1">{plural(changes.length, "change")}</h2>
        <div class="pop">
          <button class="popbtn" id="fBtn" aria-haspopup="listbox" aria-expanded="false" aria-controls="fMenu"><span id="fLabel">All changes</span><svg viewBox="0 0 9 12" aria-hidden="true"><path d="M1.5 4 4.5 1 7.5 4M1.5 8l3 3 3-3"/></svg></button>
          <ul class="menu" id="fMenu" role="listbox" aria-label="Filter changes" tabindex="-1">
            <li class="mi" role="option" data-f="all" aria-selected="true"><svg class="ck" viewBox="0 0 12 12"><path d="M2 6.5 5 9.5 10 2.5"/></svg>All changes<span class="n">{changes.length}</span></li>
            {majors > 0 && <li class="mi" role="option" data-f="major" aria-selected="false"><svg class="ck" viewBox="0 0 12 12"><path d="M2 6.5 5 9.5 10 2.5"/></svg>Major only<span class="n">{majors}</span></li>}
            {cats.length > 0 && <li role="presentation"><hr /></li>}
            {cats.length > 0 && <li class="cap" role="presentation">Topic</li>}
            {cats.map(([cat, n]) => (
              <li class="mi" role="option" data-f={cat} aria-selected="false"><svg class="ck" viewBox="0 0 12 12"><path d="M2 6.5 5 9.5 10 2.5"/></svg>{CATEGORY_LABELS[cat] ?? cat}<span class="n">{n}</span></li>
            ))}
            <li role="presentation"><hr /></li>
            <li class="cap" role="presentation">Company</li>
            {companies.filter((c) => c.changes).map((c) => (
              <li class="mi" role="option" data-f={`co:${c.id}`} aria-selected="false"><svg class="ck" viewBox="0 0 12 12"><path d="M2 6.5 5 9.5 10 2.5"/></svg>{c.name}<span class="n">{c.changes}</span></li>
            ))}
          </ul>
        </div>
      </div>
      <p class="filter-note" id="filterNote" hidden><span id="filterText"></span><button type="button" id="clearFilter">Show all changes</button></p>
      {months.map((m) => (
        <div class={m.older ? "month-group older" : "month-group"}>
          <h3 class="month">{m.label}</h3>
          {m.items.map((c) => <ChangeRow change={c} base={base} ageClass={ageClass} />)}
        </div>
      ))}
      {olderCount > 0 && <button class="ghost show-older" id="showOlder" type="button" hidden>Show {plural(olderCount, "older change")}</button>}
      <div class="empty" id="empty" style={changes.length ? "" : "display:block"}><b>No changes match this filter</b>Pick "All changes" to see everything. New changes appear here the morning they're found.</div>
      <p class="foot">A solid dot means the change was found in the last month; over the following year it fades to an outline. Changes from the Internet Archive are dated when the archive first saw the new version.</p>
      {noArchive.length > 0 && (
        <div class="pending"><div><b>No older history for {new Intl.ListFormat("en", { type: "disjunction" }).format(noArchive)}</b>The Internet Archive has no readable copies of {noArchive.length === 1 ? "its" : "their"} policies, so tracking starts from the first daily check.</div></div>
      )}
      {historyPending.length > 0 && (
        <div class="pending"><div><b>History still loading for {historyPending.length} {historyPending.length === 1 ? "company" : "companies"}</b>Their older versions get read from the Internet Archive next.</div><div class="names">{historyPending.map((n) => <span>{n}</span>)}</div></div>
      )}
    </section>

    <section class="watch panel" aria-label="Companies" data-v="companies">
      <div class="h"><h2>All companies</h2><span class="m">Pin to keep in your bar</span></div>
      <div id="watch"></div>
      <p class="foot">The dot shows how recent each company's latest change is: solid if it was in the last month, fading to an outline over a year. Red means that change was rated Major.</p>
    </section>

    {charts.length ? charts.map((ch) => (
      <section data-v="history" data-chart-key={ch.key} class="chart card panel" aria-label={`${ch.title}, length over time`}>
        <div class="h"><h2>{ch.title}, length over time</h2><div class="legend"><span><i></i>Length in words</span><span><i class="lg-add"></i>Lines added</span><span><i class="lg-cut"></i>Lines cut</span><span><i class="lg-skip"></i>Layout-only copy, skipped</span></div></div>
        <div style="position:relative" class="chartwrap" data-chart={ch.key}><svg aria-hidden="true"></svg><div class="tipbox"></div></div>
        <ol class="timeline" aria-label={`Changes to the ${ch.title}`}>
          {ch.changes.map((c) => (
            <li><a href={`${base}/change/${c.id}/`}>
              <span class="when">{fmt(c.date)}</span>
              <span class={`tl-dot sev-${c.severity} ${ageClass(c.date)}`} aria-hidden="true"></span>
              <span class="tl-h">{c.label}</span>
              {rated(c) ? <span class={`sev ${SEV[c.severity] ?? ""}`}>{sevLabel(c.severity)}</span> : <span></span>}
            </a></li>
          ))}
        </ol>
      </section>
    )) : (
      <section data-v="history" class="chart card panel"><div class="h"><h2>No history loaded yet</h2></div><p class="noquote">Older versions of these pages haven't been loaded yet. They will appear here once they are.</p></section>
    )}
  </main>
</Base>
