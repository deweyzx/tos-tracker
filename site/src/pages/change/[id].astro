---
// One page per change: the AI summary, what you can do, and the exact wording before and after.
import Base from "../../layouts/Base.astro";
import Hunk from "../../components/Hunk.astro";
import { loadData, CATEGORY_LABELS, whenFound } from "../../lib/data.js";
import { renames } from "../../lib/redline.js";

export function getStaticPaths() {
  return loadData().allChanges.map((change) => ({ params: { id: change.id }, props: { change } }));
}

const { change: c } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fmtLong = (d) => new Date(d + "T00:00:00Z").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const SEV = { major: "major", moderate: "mod" };
const rated = c.severity && c.severity !== "pending";
// Afterglow on the change page too: the dot by the date fades as the change gets older.
const days = (Date.now() - Date.parse(c.date + "T00:00:00Z")) / 864e5;
const age = days <= 31 ? "age-0" : days <= 92 ? "age-1" : days <= 365 ? "age-2" : "age-3";
const plural = (n, word) => `${n.toLocaleString("en-US")} ${word}${n === 1 ? "" : "s"}`;

const hunks = c.hunks; // already ordered: spots related to the summary first
const SHOWN = 3;
// The same small edit made in many places, listed once above the wording.
const repeated = renames(hunks);
const q = (s) => `“${s}”`;
---
<Base title={`${c.companyName} ${c.docName}, ${fmtLong(c.date)} | ToS Tracker`} description={c.summary ?? `What changed in the ${c.companyName} ${c.docName}, word for word.`}>
  <div class="detail">
    <a class="back" href={`${base}/#latest`}><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M7.5 2 3.5 6l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Back to all changes</a>

    <article class="dhead panel">
      <h1 class={c.id === loadData().featured?.id ? "vt-head" : undefined}>{c.summary ? c.headline : `${c.companyName} rewrote part of its ${c.docName}`}</h1>
      <p class={`meta-line ${age}${c.severity === "major" ? " is-major" : ""}`}><span class="dot" aria-hidden="true"></span>{rated && <span class={`sev ${SEV[c.severity] ?? ""}`}>{c.severity.charAt(0).toUpperCase() + c.severity.slice(1)}</span>}<span>{c.companyName} {c.docName}, {whenFound(c)}. {plural(c.changedWords, "word")} added or removed in {plural(c.hunks.length, "spot")}{c.percent !== null && `, about ${c.percent}% of the policy`}.</span></p>
      <p class="sum">{c.summary ?? "The plain-English summary hasn't been written yet. The exact wording is below."}</p>
      {c.repeatOf && <p class="sum caveat">The Internet Archive saved two versions of this page in turn, so this edit shows up more than once. Only the latest time is in the change list and counts, because it matches the policy today. <a href={`${base}/change/${c.repeatOf}/`}>See the latest time</a>.</p>}
      {c.likelyLayout && <p class="sum caveat">About {c.percent}% of the page changed at once. That usually means the page was redesigned or the archive saved a different version of it, not that the rules changed. Check the wording below before relying on it.</p>}
      {c.whatYouCanDo && (
        <div class="todo"><h2>What you can do</h2><p>{c.whatYouCanDo}</p></div>
      )}
      {c.categories.length > 0 && <div class="cats">{c.categories.map((cat) => <span>{CATEGORY_LABELS[cat] ?? cat}</span>)}</div>}
    </article>

    <section class="card panel" aria-labelledby="wording-title">
      <div class="h"><h2 id="wording-title">The exact wording</h2><span class="m">Most relevant spots first. Struck words were removed, underlined words were added.</span></div>
      {repeated.length > 0 && (
        <div class="repeats">
          <h3>Repeated throughout</h3>
          <ul>
            {repeated.map((r) => (
              <li><span class="doc">{r.from && r.to
                ? <><del><span class="sr-only">[removed: </span>{q(r.from)}<span class="sr-only">]</span></del> became <ins><span class="sr-only">[added: </span>{q(r.to)}<span class="sr-only">]</span></ins></>
                : r.to ? <>Added <ins>{q(r.to)}</ins></> : <>Removed <del>{q(r.from)}</del></>}</span> <span class="n">in {r.count} places</span></li>
            ))}
          </ul>
        </div>
      )}
      {hunks.slice(0, SHOWN).map((h) => (
        <Hunk hunk={h} />
      ))}
      {hunks.length > SHOWN && (
        <details class="more">
          <summary>Show the other {hunks.length - SHOWN} changed spots</summary>
          {hunks.slice(SHOWN).map((h) => (
            <Hunk hunk={h} />
          ))}
        </details>
      )}
    </section>

    <section class="card panel" aria-labelledby="source-title">
      <div class="h"><h2 id="source-title">Where this came from</h2></div>
      <p class="source-note">
        {c.source === "archive"
          ? "Found by comparing two copies of the page saved by the Internet Archive. The change happened somewhere between them."
          : "Found by the daily check, which compares today's copy of the page with yesterday's."}
      </p>
      <div class="links">
        {c.archiveBefore && <a class="ghost" href={c.archiveBefore} target="_blank" rel="noopener">Archived version before</a>}
        {c.archiveAfter && <a class="ghost" href={c.archiveAfter} target="_blank" rel="noopener">Archived version after</a>}
        {c.url && <a class="ghost" href={c.url} target="_blank" rel="noopener">Today's version</a>}
      </div>
    </section>
  </div>
</Base>
