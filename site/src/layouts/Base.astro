---
// Base.astro: the frame every page shares: background, top bar, pinned bar, search.
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import "../styles/site.css";
import { loadData } from "../lib/data.js";

// The default description says only what the site does today (no alerts yet: see PRODUCT.md).
const { title = "ToS Tracker", description = "See what changed in the privacy policies and terms of service of 12 big tech companies, word for word, with a plain-English summary of each change.", home = false } = Astro.props;
// Absolute URLs for link previews (LinkedIn, Slack, iMessage need the full address).
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/og.png`, Astro.site).href;
const data = loadData();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const latestCount = data.changes.length;
// What the browser script needs (kept small: no policy text).
const client = {
  base,
  builtAt: data.builtAt,
  companies: data.companies,
  charts: home ? data.charts : [], // only the main page draws charts
};
const tabs = [
  ["overview", "Overview"],
  ["latest", "Latest"],
  ["companies", "Companies"],
  ["history", "History"],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#F4F5F2" />
  <link rel="canonical" href={pageUrl} />
  <meta property="og:site_name" content="ToS Tracker" />
  <meta property="og:type" content={home ? "website" : "article"} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={shareImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="ToS Tracker: a policy sentence struck through in red, with the new wording underlined in blue." />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
</head>
<body data-home={home ? "1" : "0"}>
    <!-- proofreader's marks for the margin of every redline: caret = inserted, dele = removed, slash + caret = edited -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <symbol id="pm-ins" viewBox="0 0 16 16"><path d="M4.6 15c1.3-2.6 2.4-6 3.4-10.4.8 4.3 1.8 7.6 3.5 10.1" fill="none" stroke="#1D4ED8" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="pm-del" viewBox="0 0 16 16"><path d="M1.5 12.5c3 0 5.6-1.6 6.6-4.6.8-2.4-.6-4.4-2.3-3.6-1.6.8-.9 3.6 1.4 5.6 2 1.8 4.6 2.6 7.3 2" fill="none" stroke="#C1121F" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="pm-mod" viewBox="0 0 16 16"><path d="M3 14 8.5 2" fill="none" stroke="#C1121F" stroke-width="1.7" stroke-linecap="round"/><path d="M8.8 15c.9-1.6 1.6-3.7 2.3-6.4.6 2.6 1.3 4.6 2.5 6.2" fill="none" stroke="#1D4ED8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    </svg>
  <a class="skip" href="#content">Skip to content</a>

  <div class="page" id="content" tabindex="-1">
    <header class="top">
      <a class="brand" href={`${base}/`}><svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><path class="m-add" d="M4 15.5h16" stroke-width="2.6" stroke-linecap="round"/><path class="m-del" d="M3 9.5h18" pathLength="1" stroke-width="2.6" stroke-linecap="round"/><path d="M4 9.5h16" stroke="#16181D" stroke-width="1" stroke-linecap="round" opacity=".35"/></svg>ToS Tracker</a>
      <nav class="nav" aria-label="Sections" id="nav">
        <span class="pillx" id="pillx" aria-hidden="true"></span>
        {tabs.map(([id, label], i) => (
          <a href={`${base}/#${id}`} data-view={id} aria-current={home && i === 0 ? "page" : undefined}>
            {label}{id === "latest" && latestCount > 0 && <span class="count"><span class="sr-only">, </span>{latestCount}<span class="sr-only"> changes</span></span>}
          </a>
        ))}
      </nav>
      <div class="right">
        <span class="live"><span id="checked">Checked daily</span></span>
        <button class="search" id="openSpot" aria-label="Find a company"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg><span>Find a company</span><kbd id="kh">Ctrl K</kbd></button>
      </div>
    </header>

    <slot />
  </div>

  <footer class="site-foot">
    <span>Built by Owen Moran. Summaries are written by AI from the exact policy text, and every change links to its source.</span>
    <a href="https://github.com/deweyzx/tos-tracker">Code on GitHub</a>
  </footer>
  <nav class="pinbar" id="pinbar" aria-label="Pinned companies"></nav>

  <div class="veil" id="veil"></div>
  <div class="spot" id="spot" role="dialog" aria-modal="true" aria-label="Find a company">
    <div class="spot-in"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg><input id="spotIn" type="text" role="combobox" aria-expanded="true" aria-controls="spotList" aria-autocomplete="list" placeholder="Find a company" autocomplete="off" aria-label="Find a company" /></div>
    <div class="spot-list" id="spotList" role="listbox"></div>
    <div class="spot-foot"><span>Enter shows that company's changes. The circle pins it.</span><span>Esc to close</span></div>
  </div>

  <script type="application/json" id="tos-data" set:html={JSON.stringify(client)} />
  <script>
    import "../scripts/app.js";
  </script>
</body>
</html>
